<figure class="block block-audio" data-player-style="{% if block.props.player_style %}{{ block.props.player_style }}{% else %}simple{% endif %}">
  {% assign aud = media[block.props.media_id] %}
  {% if aud %}
    <div class="audio-player" data-audio-player>
      <audio preload="metadata" controls src="{{ aud.download.href }}"></audio>
      <button type="button" class="audio-player__toggle" aria-label="Listen">
        <span class="audio-player__icon" aria-hidden="true"></span>
      </button>
      <div class="audio-player__body">
        {% if block.props.title or aud.title %}
          <div class="audio-player__title">{{ block.props.title | default: aud.title }}</div>
        {% endif %}
        <div class="audio-player__progress" data-audio-progress role="slider" aria-label="Playback position">
          <div class="audio-player__bar" data-audio-bar></div>
        </div>
        <div class="audio-player__time"><span data-audio-current>0:00</span> / <span data-audio-duration>--:--</span></div>
      </div>
      <div class="audio-player__eq" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
    </div>
  {% else %}
    <div class="audio-player audio-player--missing">Audio unavailable</div>
  {% endif %}
  {% if block.props.caption %}<figcaption>{{ block.props.caption }}</figcaption>{% endif %}
</figure>
