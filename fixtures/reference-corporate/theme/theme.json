{
  "id": "acme-corporate-v1",
  "name": "Acme Corporate",
  "description": "PCMS-THEME-T029 spike: corporate design adapted onto Theme Contract v1 with zero Core patches — different tokens, header/footer structure, templates and presets than the reference theme.",
  "version": "0.1.0",
  "theme_contract": "^1.0",
  "templates": [
    {
      "id": "page-default",
      "file": "templates/page-default.liquid",
      "accepts_content_types": ["page@1"],
      "required_fields": ["title"]
    },
    {
      "id": "service-default",
      "file": "templates/service-default.liquid",
      "accepts_content_types": ["service@1"],
      "required_fields": ["title"],
      "optional_fields": ["intro", "price", "features"]
    },
    {
      "id": "case-default",
      "file": "templates/case-default.liquid",
      "accepts_content_types": ["case@1"],
      "required_fields": ["title"],
      "optional_fields": ["client"]
    },
    {
      "id": "news-default",
      "file": "templates/news-default.liquid",
      "accepts_content_types": ["news@1"],
      "required_fields": ["title"]
    },
    {
      "id": "article-default",
      "file": "templates/article-default.liquid",
      "accepts_content_types": ["article@1"],
      "required_fields": ["title"]
    }
  ],
  "components": [
    { "id": "header", "file": "components/header.liquid" },
    { "id": "footer", "file": "components/footer.liquid" }
  ],
  "block_renderers": [
    { "block": "text@1", "file": "blocks/text.liquid" },
    { "block": "heading@1", "file": "blocks/heading.liquid" },
    { "block": "image@1", "file": "blocks/image.liquid" },
    { "block": "gallery@1", "file": "blocks/gallery.liquid" },
    { "block": "quote@1", "file": "blocks/quote.liquid" },
    { "block": "callout@1", "file": "blocks/callout.liquid" },
    { "block": "list@1", "file": "blocks/list.liquid" },
    { "block": "table@1", "file": "blocks/table.liquid" },
    { "block": "code@1", "file": "blocks/code.liquid" },
    { "block": "faq@1", "file": "blocks/faq.liquid" },
    { "block": "cta@1", "file": "blocks/cta.liquid", "variants": ["inline", "wide", "accent"] },
    { "block": "video@1", "file": "blocks/video.liquid" },
    { "block": "calculator@1", "file": "blocks/calculator.liquid" },
    { "block": "map@1", "file": "blocks/map.liquid" },
    { "block": "timeline@1", "file": "blocks/timeline.liquid" },
    { "block": "documents@1", "file": "blocks/documents.liquid" },
    { "block": "related_content@1", "file": "blocks/related_content.liquid" }
  ],
  "navigation_placements": [
    {
      "id": "header.primary",
      "required": true,
      "max_depth": 2,
      "supported_item_types": ["internal_entry", "group"]
    },
    {
      "id": "header.mobile",
      "required": true,
      "max_depth": 2,
      "supported_item_types": ["internal_entry", "group"]
    },
    { "id": "header.utility", "max_depth": 1, "supported_item_types": ["external_url", "action"] },
    { "id": "footer.primary", "max_depth": 2, "supported_item_types": ["internal_entry", "group"] },
    {
      "id": "footer.legal",
      "max_depth": 1,
      "supported_item_types": ["internal_entry", "external_url"]
    }
  ],
  "media_presets": [
    {
      "id": "hero-wide",
      "width": 1920,
      "height": 720,
      "fit": "cover",
      "crop": "entropy",
      "formats": ["webp"],
      "quality": 80,
      "loading": "eager"
    },
    {
      "id": "card-small",
      "width": 400,
      "height": 300,
      "fit": "cover",
      "formats": ["webp"],
      "quality": 75
    },
    { "id": "thumbnail", "width": 96, "height": 96, "fit": "cover" },
    { "id": "social-display", "width": 1200, "height": 630, "fit": "cover" }
  ],
  "settings_schema": [
    {
      "key": "primary_color",
      "type": "color",
      "default": "#1f3a5f",
      "token": "--color-primary",
      "label": "Фирменный синий"
    },
    {
      "key": "accent_color",
      "type": "color",
      "default": "#c0662f",
      "token": "--color-accent",
      "label": "Медь (акцент)"
    },
    {
      "key": "topbar_phone",
      "type": "string",
      "default": "+7 900 000-00-00",
      "label": "Телефон в шапке"
    },
    {
      "key": "container_width",
      "type": "number",
      "default": 1140,
      "min": 900,
      "max": 1440,
      "token": "--layout-container-max",
      "label": "Ширина контейнера"
    }
  ],
  "assets": {
    "css": ["assets/css/theme.css"],
    "fingerprint": true
  }
}
