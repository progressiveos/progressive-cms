{
  "id": "com.example.site-basics",
  "name": "Site Basics (reference)",
  "version": "1.2.3",
  "extension_contract": "2.0",
  "cms_compatibility": ">=1.0.0-rc.1 <2.0.0",
  "requires": [
    {
      "capability": "theme-contract",
      "range": "^1.0.0"
    }
  ],
  "provides": [
    {
      "capability": "site-basics.greeting",
      "version": "1.0.0"
    }
  ],
  "permissions": ["extensions.manage"],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "greeting": {
        "type": "string",
        "maxLength": 200,
        "default": "Hello"
      },
      "enabled_features": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 16
      }
    }
  },
  "migrations": {
    "dir": "migrations"
  },
  "data_policy": "retain",
  "entrypoint": {
    "type": "module"
  },
  "registrations": {
    "blocks": [
      {
        "block_type": "site-basics.banner"
      }
    ],
    "routes": [
      {
        "route_id": "status",
        "kind": "system"
      }
    ],
    "event_subscriptions": [
      {
        "subscription_id": "on-entry-published",
        "event_type": "EntryPublished",
        "handler": "onEntryPublished"
      }
    ],
    "validators": [
      {
        "point": "publication",
        "validator_id": "banner-present",
        "handler": "validatePublication"
      }
    ]
  }
}
