{
  "contentTypes": [
    {
      "key": "page",
      "version": 1,
      "title": "Страница",
      "description": "Обычная структурная страница сайта",
      "bodyPolicy": "block_document",
      "fields": {
        "title": { "id": "title", "type": "string", "required": true },
        "menu_title": { "id": "menu_title", "type": "string" },
        "h1": { "id": "h1", "type": "string" },
        "slug_hint": { "id": "slug_hint", "type": "slug" },
        "intro": { "id": "intro", "type": "text" },
        "body": { "id": "body", "type": "block_document" }
      }
    },
    {
      "key": "service",
      "version": 1,
      "title": "Услуга",
      "description": "Услуга с ценой, составом и связями",
      "bodyPolicy": "block_document",
      "fields": {
        "title": { "id": "title", "type": "string", "required": true },
        "featured": { "id": "featured", "type": "boolean", "filterable": true, "sortable": true },
        "menu_order": {
          "id": "menu_order",
          "type": "integer",
          "filterable": true,
          "sortable": true
        },
        "price": { "id": "price", "type": "money" },
        "features": {
          "id": "features",
          "type": "repeater",
          "item": {
            "fields": {
              "feature_title": { "id": "feature_title", "type": "string" },
              "feature_text": { "id": "feature_text", "type": "text" }
            }
          }
        },
        "related_services": {
          "id": "related_services",
          "type": "relation_list",
          "accepts": ["service"]
        }
      }
    },
    {
      "key": "case",
      "version": 1,
      "title": "Кейс",
      "description": "Портфолио: выполненный проект",
      "bodyPolicy": "rich_text",
      "fields": {
        "title": { "id": "title", "type": "string", "required": true },
        "client": { "id": "client", "type": "string" },
        "completed_on": { "id": "completed_on", "type": "date" },
        "hero_image": { "id": "hero_image", "type": "media" },
        "gallery": { "id": "gallery", "type": "media_list" },
        "body": { "id": "body", "type": "rich_text" }
      }
    },
    {
      "key": "news",
      "version": 1,
      "title": "Новость",
      "description": "С новостной ленты",
      "bodyPolicy": "rich_text",
      "fields": {
        "title": { "id": "title", "type": "string", "required": true },
        "published_at": {
          "id": "published_at",
          "type": "datetime",
          "filterable": true,
          "sortable": true
        },
        "teaser": { "id": "teaser", "type": "text" },
        "body": { "id": "body", "type": "rich_text" }
      }
    },
    {
      "key": "article",
      "version": 1,
      "title": "Статья",
      "description": "Экспертная статья с тегами",
      "bodyPolicy": "rich_text",
      "fields": {
        "title": { "id": "title", "type": "string", "required": true },
        "author": { "id": "author", "type": "string" },
        "tags": { "id": "tags", "type": "list", "item": { "id": "tag", "type": "string" } },
        "body": { "id": "body", "type": "rich_text" }
      }
    }
  ],
