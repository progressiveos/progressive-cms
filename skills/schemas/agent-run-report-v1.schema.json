{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://progressive-cms.dev/schemas/agent-run-report-v1.json",
  "title": "Progressive CMS agent run report v1",
  "description": "Structured end-of-run report for both first-party Agent Skills (PCMS-SKILL-T011). Secret-free by contract: no token values, credentials, secrets or secret references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill",
    "run_id",
    "target",
    "actor",
    "task",
    "changes",
    "validation",
    "publication_state",
    "warnings",
    "conflicts",
    "remaining_human_action"
  ],
  "properties": {
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "run_id": { "type": "string", "minLength": 8, "maxLength": 200 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site", "environment"],
      "properties": {
        "site": { "type": "string", "maxLength": 100 },
        "environment": {
          "type": "string",
          "enum": ["development", "staging", "production", "test"]
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "maxLength": 64 },
        "permission_summary": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "maxLength": 64 }
        }
      }
    },
    "task": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "changes": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "action"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "entry",
              "revision",
              "media",
              "seo",
              "changeset",
              "bundle",
              "plan",
              "external_identity",
              "navigation",
              "theme_file",
              "other"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "created",
              "updated",
              "sealed",
              "published",
              "scheduled",
              "skipped",
              "archived"
            ]
          },
          "id": { "type": "string", "maxLength": 100 },
          "external_id": { "type": "string", "maxLength": 500 },
          "path": { "type": "string", "maxLength": 500 },
          "note": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "affected_ids": {
      "type": "array",
      "maxItems": 5000,
      "items": { "type": "string", "maxLength": 100 }
    },
    "validation": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "result"],
        "properties": {
          "gate": { "type": "string", "maxLength": 100 },
          "result": { "type": "string", "enum": ["pass", "pass_with_warnings", "fail", "skipped"] },
          "issues": { "type": "integer", "minimum": 0 },
          "note": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "performed": { "type": "boolean" },
        "available": { "type": "boolean" },
        "url_kind": {
          "type": "string",
          "enum": ["signed_preview", "seo_preview", "theme_preview", "none"]
        }
      }
    },
    "publication_state": {
      "type": "string",
      "enum": [
        "none",
        "prepared",
        "planned",
        "scheduled",
        "published",
        "partially_published",
        "blocked_by_permission",
        "blocked_by_conflict",
        "blocked_by_compatibility"
      ]
    },
    "tests": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "result"],
        "properties": {
          "name": { "type": "string", "maxLength": 200 },
          "result": { "type": "string", "enum": ["pass", "fail", "skipped"] },
          "note": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 1000,
      "items": { "type": "string", "maxLength": 1000 }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code"],
        "properties": {
          "code": { "type": "string", "maxLength": 100 },
          "entry_id": { "type": "string", "maxLength": 100 },
          "external_id": { "type": "string", "maxLength": 500 },
          "baseline_generation": { "type": "integer", "minimum": 0 },
          "current_generation": { "type": "integer", "minimum": 0 },
          "source_changed": { "type": "boolean" },
          "note": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "remaining_human_action": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "maxLength": 1000 }
    }
  }
}
