{
  "id": "company-starter",
  "name": "Example company starter",
  "version": "1.0.0",
  "theme_contract": "^1.0",
  "cms_compatibility": ">=1.0.0-rc.19 <2.0.0-0",
  "templates": [
    {
      "id": "company-page",
      "file": "templates/page.liquid",
      "accepts_content_types": [
        "company_page@1"
      ],
      "required_fields": [
        "title"
      ]
    },
    {
      "id": "company-news",
      "file": "templates/article.liquid",
      "accepts_content_types": [
        "company_news@1"
      ],
      "required_fields": [
        "title"
      ]
    },
    {
      "id": "company-project",
      "file": "templates/article.liquid",
      "accepts_content_types": [
        "company_project@1"
      ],
      "required_fields": [
        "title"
      ]
    }
  ],
  "components": [
    {
      "id": "header",
      "file": "components/header.liquid"
    },
    {
      "id": "footer",
      "file": "components/footer.liquid"
    },
    {
      "id": "breadcrumbs",
      "file": "components/breadcrumbs.liquid"
    },
    {
      "id": "feeds",
      "file": "components/feeds.liquid"
    }
  ],
  "block_renderers": [
    {
      "block": "heading@1",
      "file": "blocks/heading.liquid"
    },
    {
      "block": "text@1",
      "file": "blocks/text.liquid"
    },
    {
      "block": "form@1",
      "file": "blocks/form.liquid"
    }
  ],
  "navigation_placements": [
    {
      "id": "header.primary",
      "required": true,
      "max_depth": 1,
      "supported_item_types": [
        "internal_entry",
        "external_url"
      ]
    },
    {
      "id": "header.mobile",
      "required": true,
      "max_depth": 1,
      "supported_item_types": [
        "internal_entry",
        "external_url"
      ]
    },
    {
      "id": "footer.primary",
      "required": true,
      "max_depth": 1,
      "supported_item_types": [
        "internal_entry",
        "external_url"
      ]
    }
  ],
  "media_presets": [
    {
      "id": "card",
      "width": 640,
      "height": 400,
      "fit": "cover",
      "formats": [
        "webp"
      ]
    }
  ],
  "settings_schema": [],
  "collections": {
    "news": {
      "content_types": [
        "company_news"
      ],
      "page_size": 6,
      "templates": [
        "company-page"
      ]
    },
    "projects": {
      "content_types": [
        "company_project"
      ],
      "page_size": 6,
      "templates": [
        "company-page"
      ]
    }
  },
  "assets": {
    "css": [
      "assets/theme.css"
    ],
    "js": [
      "assets/forms.js"
    ]
  }
}
