<!doctype html><html lang="{{ request.locale | default: 'en' }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">{{ head_html }}<link rel="stylesheet" href="/themes/company-starter/assets/theme.css"><style>{{ tokens_css }}</style></head><body>{% include 'components/header.liquid' %}<main id="content">{% include 'components/breadcrumbs.liquid' %}<h1>{{ entry.title }}</h1>{% assign cover = media[entry.fields.hero_image].presets.card %}{% if cover %}<img src="{{ cover.src }}" srcset="{{ cover.srcset }}" alt="{{ cover.alt }}" loading="lazy">{% endif %}{% if entry.fields.intro %}<p>{{ entry.fields.intro }}</p>{% endif %}{{ blocks_html }}{% include 'components/feeds.liquid' %}</main>{% include 'components/footer.liquid' %}<script src="/themes/company-starter/assets/forms.js" defer></script></body></html>
