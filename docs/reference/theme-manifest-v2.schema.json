{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://progressive-cms.dev/schemas/theme-manifest-v2.json",
  "title": "Progressive CMS theme manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "theme_contract",
    "templates",
    "components",
    "block_renderers",
    "navigation_placements",
    "media_presets",
    "settings_schema"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "theme_contract": {
      "type": "string",
      "pattern": "^[0-9A-Za-z.+*<>=~^|, -]{1,128}$"
    },
    "cms_compatibility": {
      "type": "string",
      "pattern": "^[0-9A-Za-z.+*<>=~^|, -]{1,128}$"
    },
    "requires": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9A-Za-z.+*<>=~^|, -]{1,128}$"
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    },
    "directories": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["scripts", "styles", "locales", "tests"]
      }
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/definitions/template"
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/definitions/template_id"
        }
      }
    },
    "components": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/definitions/component"
      }
    },
    "block_renderers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/definitions/block_renderer"
      }
    },
    "navigation_placements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/definitions/navigation_placement"
      }
    },
    "media_presets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/definitions/media_preset"
      }
    },
    "settings_schema": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/definitions/setting"
      }
    },
    "collections": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content_types"],
        "properties": {
          "content_types": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "tag_field": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "templates": {
            "type": "array",
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "css": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "pattern": "^(templates|components|blocks|assets)/[a-z0-9][a-z0-9._/-]{0,127}\\.(liquid|css|js|svg|png|jpg|jpeg|webp|avif|woff2|json|txt)$"
          }
        },
        "js": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "pattern": "^(templates|components|blocks|assets)/[a-z0-9][a-z0-9._/-]{0,127}\\.(liquid|css|js|svg|png|jpg|jpeg|webp|avif|woff2|json|txt)$"
          }
        },
        "fingerprint": {
          "type": "boolean"
        },
        "csp": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "script_src",
              "style_src",
              "img_src",
              "font_src",
              "connect_src",
              "frame_src",
              "media_src"
            ]
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "pattern": "^'self'$|^https://[a-z0-9.-]+(:\\d{1,5})?$"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "template_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "accepts_content_types"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "file": {
          "type": "string",
          "pattern": "^templates/[a-z0-9][a-z0-9._/-]{0,127}\\.liquid$"
        },
        "accepts_content_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}@[1-9]\\d*$"
          }
        },
        "accepts_views": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9_-]*@\\d+$"
          }
        },
        "required_fields": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        },
        "optional_fields": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        },
        "supported_blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        },
        "globals": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        },
        "editor_selectable": {
          "type": "boolean"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "file": {
          "type": "string",
          "pattern": "^components/[a-z0-9][a-z0-9._/-]{0,127}\\.liquid$"
        }
      }
    },
    "block_renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block", "file"],
      "properties": {
        "block": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}@[1-9]\\d*$"
        },
        "file": {
          "type": "string",
          "pattern": "^blocks/[a-z0-9][a-z0-9._/-]{0,127}\\.liquid$"
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        }
      }
    },
    "navigation_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "max_depth", "supported_item_types"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}(\\.[a-z][a-z0-9_-]{0,31}){1,3}$"
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "required": {
          "type": "boolean"
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "supported_item_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["internal_entry", "external_url", "anchor", "group", "separator", "action"]
          }
        },
        "fallback": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}(\\.[a-z][a-z0-9_-]{0,31}){1,3}$"
        },
        "supports_mega_menu": {
          "type": "boolean"
        }
      }
    },
    "media_preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "width"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "width": {
          "type": "integer",
          "minimum": 16,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 16,
          "maximum": 8192
        },
        "fit": {
          "type": "string",
          "enum": ["cover", "contain", "fill", "inside", "outside"]
        },
        "crop": {
          "type": "string",
          "enum": ["center", "top", "bottom", "left", "right", "entropy"]
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["avif", "webp", "jpeg", "png"]
          }
        },
        "quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "loading": {
          "type": "string",
          "enum": ["lazy", "eager"]
        }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "type": {
          "type": "string",
          "enum": ["boolean", "string", "enum", "number", "color", "media"]
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "token": {
          "type": "string",
          "pattern": "^--[a-z][a-z0-9-]*$"
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "default": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "string"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            }
          },
          "then": {
            "required": ["choices"],
            "properties": {
              "default": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "number"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "number"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "color"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{3,8}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "media"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "string",
                "oneOf": [
                  {
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  {
                    "pattern": "^assets/[a-z0-9][a-z0-9._/-]*$"
                  },
                  {
                    "maxLength": 0
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["color", "media"]
              }
            }
          },
          "then": {
            "required": ["token"]
          }
        }
      ]
    }
  }
}
