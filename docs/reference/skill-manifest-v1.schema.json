{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://progressive-cms.dev/schemas/skill-manifest-v1.json",
  "title": "Progressive CMS agent skill manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "description",
    "entry_workflow",
    "safety_levels"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,63}$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cms": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "contracts": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "minimum_capabilities": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "optional_capabilities": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    },
    "recommended_scopes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "optional_scopes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "dangerous_optional_scopes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "entry_workflow": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "safety_levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "enum": [
          "READ",
          "DRAFT_WRITE",
          "PREVIEW",
          "SCHEDULE",
          "PUBLIC_MUTATION",
          "SECURITY_ACTIVATION"
        ]
      }
    },
    "references": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author"
      ],
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "homepage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
