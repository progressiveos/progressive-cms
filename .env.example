# Progressive CMS secret channel — copy to `.env` (gitignored) and fill real
# values. Secret VALUES live only here (or in permission-restricted files);
# the config file references them by name, never inline (Operations spec §9).
#
# Referenced from config via:
#   "secrets": { "db.password": { "env": "PCMS_SECRET_DB_PASSWORD" } }
PCMS_SECRET_DB_PASSWORD=

# PCMS-OPS-T003: base connection for PostgreSQL integration tests. Tests
# create uniquely named disposable databases on this server and drop them
# afterwards; the base database itself is never written by tests.
# Without this variable the DB integration tests are skipped.
PCMS_TEST_DATABASE_URL=postgres://user:password@127.0.0.1:5432/pcms
