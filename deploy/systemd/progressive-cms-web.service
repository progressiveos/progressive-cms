# Progressive CMS web service. The active release is read-only; site
# configuration and mutable state are stored separately.
# The web process does not run migrations. Database connections are opened
# lazily, and readiness remains false until PostgreSQL responds.

[Unit]
Description=Progressive CMS web process
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=progressive-cms
Group=progressive-cms
# systemd recreates the runtime directory at every start.
RuntimeDirectory=progressive-cms
WorkingDirectory=/opt/progressive-cms/current
ExecStart=/usr/bin/node /opt/progressive-cms/current/apps/web/src/main.js --config /etc/progressive-cms/pcms.json
# Graceful drain (config http.shutdownTimeoutMilliseconds + margin).
TimeoutStopSec=20
# Bounded backoff keeps failures visible in journald and avoids a crash loop.
Restart=on-failure
RestartSec=5s

# Deliberate hardening exclusions:
#   * MemoryDenyWriteExecute is NOT set — V8 JIT needs W^X executable memory;
#     enabling it breaks the Node.js runtime outright.
#   * RestrictAddressFamilies keeps AF_INET/AF_INET6 for HTTP and outbound
#     database, mail and connector connections.
#   * SystemCallFilter is not set because Node/V8 needs a reviewed syscall
#     profile before one can be applied safely.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
# Permit the runtime user to write only state, restart markers and the
# incoming release staging directory.
ReadWritePaths=/var/lib/progressive-cms /run/progressive-cms /opt/progressive-cms/incoming

# Resource ceilings bound a runaway process; host limits remain primary.
LimitNOFILE=16384
MemoryMax=1500M

[Install]
WantedBy=multi-user.target
