#
# Progressive CMS worker service. The active release is read-only; site
# configuration and mutable state are stored separately.
# The worker does not run migrations. It retries transient database
# unavailability and processes durable jobs and outbox events.

[Unit]
Description=Progressive CMS worker process
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=progressive-cms
Group=progressive-cms
# systemd recreates the runtime directory at every start.
RuntimeDirectory=progressive-cms
WorkingDirectory=/opt/progressive-cms/current
ExecStart=/usr/bin/node /opt/progressive-cms/current/apps/worker/src/main.js --config /etc/progressive-cms/pcms.json
# Graceful drain (bounded job/outbox shutdown + margin).
TimeoutStopSec=25
# Bounded backoff keeps failures visible in journald and avoids a crash loop.
Restart=on-failure
RestartSec=5s

# Deliberate hardening exclusions:
#   * MemoryDenyWriteExecute is NOT set — V8 JIT needs W^X executable memory.
#   * SystemCallFilter is not set until a Node/V8 profile has been reviewed.
#   * RestrictAddressFamilies keeps AF_INET/AF_INET6 for outbound database,
#     mail and integration connector connections.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
# /opt/progressive-cms (releases) and /etc stay read-only for the runtime user.
ReadWritePaths=/var/lib/progressive-cms /run/progressive-cms

# Small-site resource ceiling (see web unit — container limits remain primary).
LimitNOFILE=16384
MemoryMax=1000M

[Install]
WantedBy=multi-user.target
