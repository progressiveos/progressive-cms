// Polkit authorization for the Progressive CMS update orchestration
//
// The sandboxed service user may drive EXACTLY these unit operations via the
// systemd D-Bus API (NoNewPrivileges forbids sudo inside the web sandbox):
//   - start the backup and install oneshot units
//   - restart or query the web and worker units
// Everything else keeps the distro defaults. Installed to
// /etc/polkit-1/rules.d/49-progressive-cms-update.rules by provision-site.sh.

polkit.addRule(function (action, subject) {
    if (subject.user !== "progressive-cms") {
        return;
    }
    var managedUnits = [
        "progressive-cms-backup.service",
        "progressive-cms-install.service",
        "progressive-cms-web.service",
        "progressive-cms-worker.service",
    ];
    if (action.id === "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        if (unit !== null && managedUnits.indexOf(unit) !== -1) {
            return polkit.Result.YES;
        }
    }
});
